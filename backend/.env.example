# Django
SECRET_KEY=gere-uma-chave-secreta-forte
DEBUG=False
PRODUCTION=True
TIME_ZONE=America/Sao_Paulo
ALLOWED_HOSTS=.onrender.com,seu-dominio.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://seu-dominio.com

# PostgreSQL persistente (Neon, Supabase ou outro PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
DJANGO_REQUIRE_DATABASE_URL=True

# Acesso e segurança da gestão
GESTAO_AUTORIZACAO_EMAIL=gestao@exemplo.com
GESTAO_TRIAL_DIAS=7
GESTAO_SESSION_IDLE_MINUTES=30
GESTAO_SESSION_ABSOLUTE_MINUTES=480
MOBILE_LOGIN_MAX_ATTEMPTS=10
MOBILE_LOGIN_WINDOW_SECONDS=300
GESTAO_LICENCA_CONTATO_WHATSAPP=
CRIADOR_ADMIN_URL=admin-criador/
CRIADOR_ADMIN_EMAILS=admin@exemplo.com

# Primeiro gestor (somente se usar o comando criar_gestor_inicial)
GESTOR_INICIAL_SENHA=

# E-mail por Brevo API
EMAIL_BACKEND=apps.core.email_backends.BrevoEmailBackend
BREVO_API_KEY=
BREVO_SENDER_EMAIL=nao-responda@exemplo.com
BREVO_SENDER_NAME=Diário Escolar Pro
DEFAULT_FROM_EMAIL=Diário Escolar Pro <nao-responda@exemplo.com>
EMAIL_TIMEOUT=20

# Servidor web
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
