# Banco PostgreSQL externo e persistente: Neon, Supabase ou outro Postgres.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
DJANGO_REQUIRE_DATABASE_URL=True

DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
GESTAO_AUTORIZACAO_EMAIL=thiago01268230@gmail.com

# Envio gratuito recomendado no Render Free: Brevo API.
EMAIL_BACKEND=apps.core.email_backends.BrevoEmailBackend
BREVO_API_KEY=sua-chave-api-da-brevo
BREVO_SENDER_EMAIL=seu-email-remetente-verificado
BREVO_SENDER_NAME=Diário IA Escolar
DEFAULT_FROM_EMAIL=Diário IA Escolar <seu-email-remetente-verificado>
EMAIL_TIMEOUT=20

# Alternativa local/PyCharm: SMTP Gmail. No Render Free, SMTP 587 é bloqueado.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app


# Segurança do login da gestão
GESTAO_SESSION_IDLE_MINUTES=30
GESTAO_SESSION_ABSOLUTE_MINUTES=480

# Django Admin restrito ao criador
# /admin/ não fica mais ativo; acesse pela URL abaixo e somente com superusuário autorizado.
CRIADOR_ADMIN_URL=admin-criador/
CRIADOR_ADMIN_EMAILS=canalescanorff28@gmail.com
# Opcional: se seu superusuário não tiver e-mail, autorize pelo username.
# CRIADOR_ADMIN_USERNAMES=seu_usuario_admin

# Validade comercial/teste da gestão
# Padrão recomendado para teste: 7 dias. Troque no Render se quiser 15, 30 etc.
GESTAO_TRIAL_DIAS=7
GESTAO_LICENCA_CONTATO_WHATSAPP=98996127032
