# Banco PostgreSQL externo e persistente: Neon, Supabase ou outro Postgres.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
DJANGO_REQUIRE_DATABASE_URL=True

DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
GESTAO_AUTORIZACAO_EMAIL=thiago01268230@gmail.com

# Envio gratuito recomendado no Render Free: Brevo API.
EMAIL_BACKEND=apps.core.email_backends.BrevoEmailBackend
BREVO_API_KEY=sua-chave-api-da-brevo
BREVO_SENDER_EMAIL=seu-email-remetente-verificado
BREVO_SENDER_NAME=Diário IA Escolar
DEFAULT_FROM_EMAIL=Diário IA Escolar <seu-email-remetente-verificado>
EMAIL_TIMEOUT=20

# Alternativa local/PyCharm: SMTP Gmail. No Render Free, SMTP 587 é bloqueado.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
