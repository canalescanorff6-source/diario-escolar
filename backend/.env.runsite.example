# RunSite - Diário IA Escolar
# Projeto: https://diario-escolar.runsite.app
# Cole estes valores em Environment Variables da RunSite.
# NÃO compartilhe DATABASE_URL, BREVO_API_KEY e SECRET_KEY em prints/chats.

RUNSITE=true
PRODUCTION=true
PYTHON_VERSION=3.13.5
DEBUG=False
DJANGO_REQUIRE_DATABASE_URL=True

# Banco PostgreSQL externo/persistente. Use a mesma DATABASE_URL do Neon.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Domínio exato da RunSite já configurado.
ALLOWED_HOSTS=diario-escolar.runsite.app,.runsite.app,diario-escolar.onrender.com,.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://diario-escolar.runsite.app,https://*.runsite.app,https://diario-escolar.onrender.com,https://*.onrender.com

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

WEB_CONCURRENCY=1
GUNICORN_THREADS=2

GESTAO_AUTORIZACAO_EMAIL=thiago01268230@gmail.com
GESTAO_TRIAL_DIAS=30
GESTAO_LICENCA_CONTATO_WHATSAPP=98996127032
GESTAO_SESSION_IDLE_MINUTES=30
GESTAO_SESSION_ABSOLUTE_MINUTES=480

CRIADOR_ADMIN_URL=admin-criador/
CRIADOR_ADMIN_EMAILS=canalescanorff28@gmail.com

EMAIL_BACKEND=apps.core.email_backends.BrevoEmailBackend
BREVO_API_KEY=sua-chave-api-da-brevo
BREVO_SENDER_EMAIL=thiago01268230@gmail.com
BREVO_SENDER_NAME=Diário IA Escolar
DEFAULT_FROM_EMAIL=Diário IA Escolar <thiago01268230@gmail.com>
EMAIL_TIMEOUT=20

# Recomendado: gere uma SECRET_KEY forte.
SECRET_KEY=troque-por-uma-chave-secreta-grande
